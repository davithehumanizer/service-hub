# Frontend settings. Copy to `.env` next to this file (gitignored): the Docker
# build copies it and fails without it. CRA bakes every REACT_APP_* into the
# bundle at build time, so rebuild the image after a change.

# Base URL of the API gateway, /api included.
REACT_APP_API_URL=http://localhost:3000/api

# Port of the development server (`npm start`).
PORT=3010

# Public PartsFinder catalogue that spare part results link to.
# Default: https://data.spareparts.care2repair.eu
# REACT_APP_SPAREPARTS_URL=

# Target of the source code link in the sidebar. A modified version run as a
# network service must point it at its own source (README.md, "Licence").
# REACT_APP_SOURCE_URL=https://github.com/davithehumanizer/service-hub

# Retorik information agent, shown only when a tenant is set. It is operated by
# DAVI and not covered by the licence (README.md).
# REACT_APP_RETORIK_TENANT=
# REACT_APP_RETORIK_PREFIX=
