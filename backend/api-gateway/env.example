# api-gateway settings. Copy to `.env` next to this file (gitignored).
#
# docker-compose.yml sets the addresses of the other services, the storage and
# FRONTEND_URL, and wins over this file: add them here only to run the gateway
# outside Docker.

# Signs and checks the session tokens. The same value goes in user-management
# and oauth-service; README.md says how to generate it.
JWT_SECRET=

# OAuth2 / OpenID Connect. OAUTH_PUBLIC_KEY is the public half of the key pair
# in oauth-service/.env, and these three must match the values there.
OIDC_ISSUER=http://localhost:3000
OAUTH_RSA_KID=rs256-1
OAUTH_PUBLIC_KEY=

# Social login. The gateway refuses to start if either pair is empty: keep the
# placeholders until you register an app with Google or Facebook.
GOOGLE_CLIENT_ID=unset
GOOGLE_CLIENT_SECRET=unset
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
FACEBOOK_APP_ID=unset
FACEBOOK_APP_SECRET=unset
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/auth/facebook/callback

# Browser origins allowed to call the API, comma-separated. Default: any.
# CORS_ORIGINS=http://localhost:3010

# Requests per minute per client across the whole API. Default: 300.
# THROTTLE_GLOBAL_LIMIT=300
