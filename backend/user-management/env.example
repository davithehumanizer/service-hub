# user-management settings. Copy to `.env` next to this file (gitignored).
#
# docker-compose.yml sets the database connection, the address of
# notifications-service and FRONTEND_URL (from the root .env), and wins over
# this file: add them here only to run the service outside Docker.

# Same value as in api-gateway and oauth-service.
JWT_SECRET=

# Google reCAPTCHA v3 secret. Empty: sign-up and login skip the check.
RECAPTCHA_SECRET=

# Lowest reCAPTCHA score accepted when the check runs. Default: 0.5.
# RECAPTCHA_MIN_SCORE=0.5

# Days a refresh token stays valid. Default: 30.
# REFRESH_TOKEN_TTL_DAYS=30

# Lets TypeORM rewrite the schema to match the entities at startup, which can
# drop columns. Local development only: docs/migrations.md.
# TYPEORM_SYNCHRONIZE=true
