# spare-parts-service settings. Copy to `.env` next to this file (gitignored).

# Meilisearch instance holding the spare parts catalogue, and a token allowed to
# search it. Empty token: spare parts searches find nothing.
# MEILISEARCH_URL=https://search.spc-e6.cris-tech.io
MEILISEARCH_SEARCH_TOKEN=

# PartsFinder API client. Empty: searches go to Meilisearch alone.
# PARTSFINDER_API_URL=https://api.spareparts.care2repair.eu
PARTSFINDER_CLIENT_ID=
PARTSFINDER_CLIENT_SECRET=
