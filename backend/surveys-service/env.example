# surveys-service settings. Copy to `.env` next to this file (gitignored).
#
# Nothing is required: docker-compose.yml sets the database connection, and
# wins over this file. Add it here only to run the service outside Docker.

# Lets TypeORM rewrite the schema to match the entities at startup, which can
# drop columns. Local development only: docs/migrations.md.
# TYPEORM_SYNCHRONIZE=true
