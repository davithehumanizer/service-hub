# oauth-service settings. Copy to `.env` next to this file (gitignored).
#
# docker-compose.yml sets the database connection and the address of
# user-management, and wins over this file: add them here only to run the
# service outside Docker.

# Same value as in api-gateway and user-management.
JWT_SECRET=

# Key pair that signs the OAuth2 tokens, each PEM base64-encoded on one line;
# README.md says how to generate them. The service refuses to start without
# them. The issuer, kid and public key must match api-gateway/.env.
OIDC_ISSUER=http://localhost:3000
OAUTH_RSA_KID=rs256-1
OAUTH_PRIVATE_KEY=
OAUTH_PUBLIC_KEY=

# Lets TypeORM rewrite the schema to match the entities at startup, which can
# drop columns. Local development only: docs/migrations.md.
# TYPEORM_SYNCHRONIZE=true
