# external-adapters-service settings. Copy to `.env` next to this file
# (gitignored).
#
# docker-compose.yml sets IFIXIT_API_URL, and wins over this file: add it here
# only to run the service outside Docker.

# YouTube Data API key, for repair videos. Empty: video search returns nothing.
YOUTUBE_API_KEY=

# YouTube searches allowed per day; each costs 100 of the 10,000 daily quota
# units. Default: 80.
# YOUTUBE_DAILY_BUDGET=80
