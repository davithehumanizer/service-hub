# notifications-service settings. Copy to `.env` next to this file
# (gitignored).
#
# docker-compose.yml sets the database connection and sends mail over SMTP to
# port 25 of the host (MAILER_*, SMTP_HOST, SMTP_PORT), and wins over this
# file. With nothing listening there, sending fails and is logged.

# Sender of every email. Default: "Support" <support@care2repair.eu>.
# MAIL_FROM="Support" <support@example.org>

# SMTP credentials, if the server asks for them.
# SMTP_USER=
# SMTP_PASSWORD=

# true for TLS from the first byte (port 465). Default: false.
# SMTP_SECURE=false

# Recipient of the test email route when the request names none.
# TEST_MAIL_TO=

# Lets TypeORM rewrite the schema to match the entities at startup, which can
# drop columns. Local development only: docs/migrations.md.
# TYPEORM_SYNCHRONIZE=true
