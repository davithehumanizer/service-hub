# Local overrides for docker-compose.yml — copy to `.env` (gitignored).
#
#   cp env.example .env
#
# Docker Compose reads `.env` in this directory automatically and uses it to
# substitute ${VAR} in docker-compose.yml. Leaving a variable out keeps the
# production default that is committed in the compose file, which is what the
# server relies on: its root .env, if any, only holds POSTGRES_PASSWORD.
#
# This file only rewrites docker-compose.yml. Service-level settings
# (TYPEORM_SYNCHRONIZE, CORS_ORIGINS, THROTTLE_GLOBAL_LIMIT,
# REFRESH_TOKEN_TTL_DAYS, DATABASE_*, JWT_SECRET...) go in the per-service
# backend/<service>/.env files instead.

# Base URL used to build the links in confirmation and password-reset emails.
FRONTEND_URL=http://localhost:3010

# Public base URL of locally stored uploads, returned to clients as the image
# URL for device identification.
LOCAL_STORAGE_PUBLIC_URL=http://localhost:3000/api/uploads

# Password of the postgres account, for the db container and every service.
# Only read when the database volume is created: changing it afterwards takes
# an ALTER USER as well (docs/OPERATIONS.md, "Database password").
# POSTGRES_PASSWORD=password
